# Floorplan Studio - AI Provider Config
# Works with any OpenAI-compatible provider: OpenAI, OpenRouter, GMI Cloud, etc.
# Also supports native Gemini and Anthropic.

# Provider: mock | openai | gemini | anthropic
#  - mock: local deterministic mock (no key needed) - great for testing UI pipeline
#  - openai: universal OpenAI-compatible (OpenAI, OpenRouter, GMI Cloud, etc.)
#  - gemini: Google Gemini native API
#  - anthropic: Anthropic Claude native API
AI_PROVIDER=mock

# Your API key - for GMI Cloud, paste your GMI api key here
AI_API_KEY=your_api_key_here

# Model ID - examples:
#  OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo
#  OpenRouter: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-pro
#  GMI Cloud: use model id provided by GMI (e.g., gpt-4o-mini, llama-3-70b, etc.)
#  Gemini: gemini-1.5-flash, gemini-1.5-pro
#  Anthropic: claude-3-5-sonnet-20240620
AI_MODEL=gpt-4o-mini

# Base URL for OpenAI-compatible APIs
#  OpenAI default: https://api.openai.com/v1
#  OpenRouter: https://openrouter.ai/api/v1
#  GMI Cloud: https://api.gmi-serving.com/v1  (or https://api.gmicloud.ai/v1)
#  IMPORTANT: Use base URL only, WITHOUT /chat/completions suffix
#  Correct: https://api.gmi-serving.com/v1
#  Wrong:   https://api.gmi-serving.com/v1/chat/completions
#  Leave empty for default
AI_BASE_URL=https://api.openai.com/v1

# Optional: OpenRouter extra headers (if using OpenRouter)
# OPENROUTER_REFERER=https://your-site.com
# OPENROUTER_TITLE=Floorplan Studio

# Database
DATABASE_URL=sqlite:///./floorplan.db
# DATABASE_URL=postgresql://user:pass@host/db

# Optional timeout seconds
# AI_TIMEOUT=30
